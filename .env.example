# Canonical site URL (no trailing slash). Falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Google Search Console HTML-tag verification token (content="..." value only).
GOOGLE_SITE_VERIFICATION=

# Google tag. Read at build time: redeploy after changing. Ignored in `next dev`
# and on Vercel preview deploys. See docs/google-ads-analytics.md.
# GA4 measurement ID, e.g. G-ABC123XYZ
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads tag ID, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads lead conversion, e.g. AW-123456789/AbCdEfGhIj (optional)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=
