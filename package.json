{
  "name": "batteries-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "catalog:projection": "vite-node scripts/build-catalog-projection.ts",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "build": "npm run catalog:validate && npm run catalog:projection && next build",
    "dev": "npm run catalog:projection && next dev",
    "start": "serve out",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
