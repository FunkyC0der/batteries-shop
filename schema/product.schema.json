{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemika.local/schema/product.schema.json",
  "title": "Product",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "source",
    "title",
    "direction",
    "status",
    "showPrice",
    "shortDescription",
    "description",
    "specs",
    "compatibility",
    "image",
    "featured"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Must match the filename without .json"
    },
    "source": {
      "type": "string",
      "enum": ["manual", "solarverse", "namato"]
    },
    "locked": {
      "type": "boolean",
      "description": "When true, importers skip this file"
    },
    "title": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string" },
    "sourceUrls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "legacySlugs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "direction": {
      "type": "string",
      "enum": ["metering-and-comfort", "energy-solutions"]
    },
    "price": { "type": "string" },
    "showPrice": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["in-stock", "preorder", "consult"]
    },
    "shortDescription": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "compatibility": {
      "type": "array",
      "items": { "type": "string" }
    },
    "compatibilityTitle": { "type": "string" },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "equipment"],
        "properties": {
          "label": { "type": "string" },
          "equipment": {
            "type": "array",
            "items": { "type": "string" }
          },
          "price": { "type": "string" }
        }
      }
    },
    "notice": { "type": "string" },
    "image": { "type": "string", "minLength": 1 },
    "images": {
      "type": "array",
      "items": { "type": "string" }
    },
    "featured": { "type": "boolean" }
  }
}
