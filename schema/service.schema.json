{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemika.local/schema/service.schema.json",
  "title": "Service",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "source",
    "title",
    "direction",
    "status",
    "showPrice",
    "shortDescription",
    "description",
    "includes",
    "duration",
    "image",
    "featured"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Must match the filename without .json"
    },
    "source": {
      "type": "string",
      "enum": ["manual", "solarverse", "namato"]
    },
    "locked": {
      "type": "boolean",
      "description": "When true, importers skip this file"
    },
    "title": { "type": "string", "minLength": 1 },
    "direction": {
      "type": "string",
      "enum": ["metering-and-comfort", "energy-solutions"]
    },
    "price": { "type": "string" },
    "showPrice": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["in-stock", "preorder", "consult"]
    },
    "shortDescription": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "includes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "duration": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "minLength": 1 },
    "featured": { "type": "boolean" }
  }
}
